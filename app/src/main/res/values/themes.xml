<resources xmlns:tools="http://schemas.android.com/tools" xmlns:name="http://schemas.android.com/apk/res-auto">
    <!-- Base application theme. -->
    <style name="Base.Theme.Munhaeryeok" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">#f6f6f6</item>
    </style>

    <style name="SystemBars.Munhaeryeok" parent="Base.Theme.Munhaeryeok">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Android 9–14 need transparent colors to draw behind both bars. -->
    <style name="Theme.Munhaeryeok" parent="SystemBars.Munhaeryeok">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="CustomTimePicker">
        <item name="android:timePickerMode">spinner</item>
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>